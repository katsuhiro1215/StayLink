# このファイルを .env にコピーして使う（.env は git に入れない）。
# 値は学習用のローカル専用。本番の値は絶対にここへ書かない。
POSTGRES_USER=staylink
POSTGRES_PASSWORD=staylink_dev_password
POSTGRES_DB=staylink
POSTGRES_PORT=5433

# アプリが読む接続先。上の値と合わせる。
DATABASE_URL=postgres://staylink:staylink_dev_password@127.0.0.1:5433/staylink?sslmode=disable

# テスト専用DB（scripts/test-db.sh が作る）。DB名は _test で終わること（開発用DBを空にしないための決まり）
TEST_DATABASE_URL=postgres://staylink:staylink_dev_password@127.0.0.1:5433/staylink_test?sslmode=disable
